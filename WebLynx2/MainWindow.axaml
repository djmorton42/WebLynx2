<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:WebLynx2"
        xmlns:controls="using:WebLynx2.Controls"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="792"
        x:Class="WebLynx2.MainWindow"
        x:DataType="local:MainWindow"
        Title="WebLynx2"
        Icon="/Assets/logo.ico"
        Width="1400" Height="792"
        MinWidth="820"
        FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="StatusNotListeningBrush" Color="#B71C1C" />
        <SolidColorBrush x:Key="StatusListeningBrush" Color="#E65100" />
        <SolidColorBrush x:Key="StatusConnectedBrush" Color="#1B5E20" />
        <SolidColorBrush x:Key="StatusBadgeForegroundBrush" Color="#FFFFFF" />
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Spacing="8">
            <Button Content="Save Changes"
                    MinWidth="100"
                    Click="SaveChanges_OnClick" />
            <Button Content="Exit"
                    MinWidth="100"
                    Click="ExitButton_OnClick" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Configuration">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              MinHeight="0">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,380"
                  ColumnSpacing="10"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <!-- Event Configuration (left) -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock Text="Event Configuration"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Event Title" />
                        <TextBox x:Name="EventTitleTextBox"
                                 Grid.Row="0" Grid.Column="1"
                                 VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Event Subtitle" />
                        <TextBox x:Name="EventSubtitleTextBox"
                                 Grid.Row="1" Grid.Column="1"
                                 VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Delayed Lap Display (s)" />
                        <NumericUpDown x:Name="DelayedDisplaySecondsNumericUpDown"
                                       Grid.Row="2" Grid.Column="1"
                                       Width="120"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Minimum="0"
                                       Maximum="60"
                                       Increment="1"
                                       Value="5"
                                       FormatString="N0"
                                       ShowButtonSpinner="True"
                                       ClipValueToMinMax="True" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="Results Configuration"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   Margin="0,4,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Unofficial Results Path" />
                        <Grid Grid.Row="4"
                              Grid.Column="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="6">
                            <TextBox x:Name="UnofficialResultsPathTextBox"
                                     Grid.Column="0"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Browse…"
                                    MinWidth="70"
                                    VerticalAlignment="Center"
                                    Click="UnofficialResultsPathBrowse_OnClick" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Official Results Path"
                                   Opacity="0.5" />
                        <Grid Grid.Row="5"
                              Grid.Column="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="6">
                            <TextBox x:Name="OfficialResultsPathTextBox"
                                     Grid.Column="0"
                                     VerticalAlignment="Center"
                                     IsEnabled="False" />
                            <Button Grid.Column="1"
                                    Content="Browse…"
                                    MinWidth="70"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Click="OfficialResultsPathBrowse_OnClick" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="File Encoding" />
                        <ComboBox x:Name="FileEncodingComboBox"
                                  Grid.Row="6" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="ISO-8859-1" />
                            <ComboBoxItem Content="UTF-8" />
                            <ComboBoxItem Content="Windows-1252" />
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Results Polling Interval (s)" />
                        <NumericUpDown x:Name="ResultsPollingIntervalNumericUpDown"
                                       Grid.Row="7" Grid.Column="1"
                                       Width="120"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Minimum="1"
                                       Maximum="3600"
                                       Increment="1"
                                       Value="1"
                                       FormatString="N0"
                                       ShowButtonSpinner="True"
                                       ClipValueToMinMax="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Server Configuration (right) -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock Text="Server Configuration"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="FinishLynx Results Port" />
                        <TextBox x:Name="ResultsPortTextBox"
                                 Grid.Row="0" Grid.Column="1"
                                 VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="FinishLynx Clock Port" />
                        <TextBox x:Name="ClockPortTextBox"
                                 Grid.Row="1" Grid.Column="1"
                                 VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="HTTP Port" />
                        <TextBox x:Name="HttpPortTextBox"
                                 Grid.Row="2" Grid.Column="1"
                                 VerticalAlignment="Center" />

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,2,0,0"
                                    Spacing="6">
                            <Button x:Name="StartServerButton"
                                    Content="Start Server"
                                    MinWidth="90"
                                    Click="StartServerButton_OnClick" />
                            <Button x:Name="StopServerButton"
                                    Content="Stop Server"
                                    MinWidth="90"
                                    IsEnabled="False"
                                    Click="StopServerButton_OnClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Network Addresses"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding NetworkAddresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Menlo, Monaco, Consolas, monospace"
                                           FontSize="11"
                                           Margin="0,0,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoNetworkAddressesTextBlock"
                               Text="No active network adapters found."
                               Opacity="0.75"
                               IsVisible="False" />

                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Results Status" />
                        <Border x:Name="ResultsStatusBadge"
                                Grid.Row="0" Grid.Column="1"
                                Background="{StaticResource StatusNotListeningBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ResultsStatusTextBlock"
                                       Text="Not Listening"
                                       Foreground="{StaticResource StatusBadgeForegroundBrush}"
                                       FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Clock Status" />
                        <Border x:Name="ClockStatusBadge"
                                Grid.Row="1" Grid.Column="1"
                                Background="{StaticResource StatusNotListeningBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ClockStatusTextBlock"
                                       Text="Not Listening"
                                       Foreground="{StaticResource StatusBadgeForegroundBrush}"
                                       FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="HTTP Status" />
                        <Border x:Name="HttpStatusBadge"
                                Grid.Row="2" Grid.Column="1"
                                Background="{StaticResource StatusNotListeningBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HttpStatusTextBlock"
                                       Text="Not Listening"
                                       Foreground="{StaticResource StatusBadgeForegroundBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            </Grid>

            <!-- View Configuration (full width) -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="0">
                <Grid RowDefinitions="Auto,*"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10"
                      MinHeight="0">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="View Configuration"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />

                    <!-- Same header row height on both columns so list tops align -->
                    <Grid Grid.Row="1"
                          Grid.Column="0"
                          RowDefinitions="Auto,*"
                          RowSpacing="4"
                          VerticalAlignment="Stretch"
                          MinHeight="0">
                        <Grid Grid.Row="0"
                              MinHeight="24"
                              VerticalAlignment="Top">
                            <TextBlock Text="Loaded Views"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox x:Name="LoadedViewsListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding LoadedViews}"
                                 MinHeight="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="0,0,0,4"
                                 SelectionChanged="LoadedViewsListBox_OnSelectionChanged">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          RowDefinitions="Auto,*"
                          RowSpacing="4"
                          VerticalAlignment="Stretch"
                          MinHeight="0">
                        <Grid Grid.Row="0"
                              MinHeight="24"
                              VerticalAlignment="Top">
                            <TextBlock Text="View Properties"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ViewProperties}"
                                 MinHeight="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="0,0,0,4">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="local:ViewPropertyRow">
                                    <Grid ColumnDefinitions="2*,2*,3*"
                                          ColumnSpacing="6">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Key}"
                                                 Watermark="Key"
                                                 VerticalAlignment="Center"
                                                 MinHeight="22"
                                                 IsReadOnly="True" />
                                        <controls:ViewPropertyValueEditor Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            DataContext="{Binding}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SourcesSummary}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
            </TabItem>

            <TabItem Header="Announcements">
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Forced Announcement"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="When applied, this text is published on race-data instead of the FinishLynx announcement. Clear to resume FinishLynx messages."
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="11" />
                        <TextBox x:Name="ForcedAnnouncementTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 Watermark="Override announcement shown on the announcements view"
                                 TextChanged="ForcedAnnouncementTextBox_OnTextChanged" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <Button Content="Apply"
                                    MinWidth="70"
                                    Click="ForcedAnnouncementApply_OnClick" />
                            <Button Content="Clear"
                                    MinWidth="70"
                                    Click="ForcedAnnouncementClear_OnClick" />
                            <Button Content="Add to Favourites"
                                    MinWidth="100"
                                    Click="AnnouncementAddFavourite_OnClick" />
                            <Button x:Name="AnnouncementRemoveFavouriteButton"
                                    Content="Remove From Favourites"
                                    MinWidth="120"
                                    IsVisible="False"
                                    Click="AnnouncementRemoveFavourite_OnClick" />
                            <TextBlock x:Name="ForcedAnnouncementStatusTextBlock"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       FontSize="11"
                                       Text="" />
                        </StackPanel>
                        <ComboBox x:Name="AnnouncementFavouritesComboBox"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Select from favorites"
                                  SelectionChanged="AnnouncementFavouritesComboBox_OnSelectionChanged" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Race State">
                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Race Status"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="RaceStatusTextBlock"
                                       Grid.Row="0" Grid.Column="1"
                                       FontFamily="Menlo, Monaco, Consolas, monospace" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Clock"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="RaceClockTextBlock"
                                       Grid.Row="1" Grid.Column="1"
                                       FontFamily="Menlo, Monaco, Consolas, monospace" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Event"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="RaceEventTextBlock"
                                       Grid.Row="2" Grid.Column="1"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Feed Status"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="RaceFeedStatusTextBlock"
                                       Grid.Row="3" Grid.Column="1"
                                       Opacity="0.85" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Announcement"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="RaceAnnouncementTextBlock"
                                       TextWrapping="Wrap"
                                       MinHeight="16"
                                       FontFamily="Menlo, Monaco, Consolas, monospace" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            VerticalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="4">
                            <TextBlock Grid.Row="0"
                                       Text="Racers"
                                       FontWeight="SemiBold" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="40,2*,2*,50,50,60,80,80,55"
                                  ColumnSpacing="8"
                                  Margin="4,0,4,0">
                                <TextBlock Grid.Column="0" Text="Lane" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="Affiliation" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="3" Text="Place" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="4" Text="Laps" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="5" Text="Delayed" FontWeight="SemiBold" Opacity="0.8"
                                           ToolTip.Tip="Lap count shown after Delayed Lap Display delay" />
                                <TextBlock Grid.Column="6" Text="Split" FontWeight="SemiBold" Opacity="0.8"
                                           ToolTip.Tip="Cumulative split time" />
                                <TextBlock Grid.Column="7" Text="Final" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="8" Text="Done" FontWeight="SemiBold" Opacity="0.8" />
                            </Grid>
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding RaceRacers}"
                                     MinHeight="160"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="4,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="local:RaceRacerDisplayRow">
                                        <Grid ColumnDefinitions="40,2*,2*,50,50,60,80,80,55"
                                              ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Lane}"
                                                       FontFamily="Menlo, Monaco, Consolas, monospace"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Affiliation}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.85" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Place}"
                                                       FontFamily="Menlo, Monaco, Consolas, monospace"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding LapsRemaining}"
                                                       FontFamily="Menlo, Monaco, Consolas, monospace"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding DelayedLapsRemaining}"
                                                       FontFamily="Menlo, Monaco, Consolas, monospace"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding Split}"
                                                       FontFamily="Menlo, Monaco, Consolas, monospace"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="7"
                                                       Text="{Binding FinalTime}"
                                                       FontFamily="Menlo, Monaco, Consolas, monospace"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="8"
                                                       Text="{Binding Finished}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
